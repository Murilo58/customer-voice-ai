# Copie para .env (fora do Git). Somente dados sintéticos fora da produção.
# Conexão do dono do schema (migrations; conexão direta, sem pooler)
DATABASE_URL_MIGRATOR=
# Conexão da aplicação (papel app_runtime, sem BYPASSRLS; pooler no Neon)
DATABASE_URL=
# neon | pg  (pg para PostgreSQL local/CI)
DATABASE_DRIVER=neon
# Senha do papel app_runtime, usada só por scripts/db/bootstrap-roles.mjs
APP_RUNTIME_PASSWORD=
# Banco de testes de integração (mesmas regras; nunca o de produção)
TEST_DATABASE_URL_MIGRATOR=
TEST_DATABASE_URL=
# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# E-mail: console (padrão; Resend aguarda a PoC 3)
EMAIL_PROVIDER=console
# Triagem por IA (I-2). Padrão "simulated" (sem rede e sem custo).
# "gemini" exige GEMINI_API_KEY e AI_TRIAGE_MODEL; sem eles, a triagem fica indisponível (modo degradado).
AI_PROVIDER=simulated
# Chave de projeto com faturamento ativo; somente em .env local ou variável sensível da Vercel, nunca no repositório.
GEMINI_API_KEY=
# Modelo escolhido pelo benchmark (precisa ter preço na tabela de provider.ts), ex.: gemini-3.1-flash-lite
AI_TRIAGE_MODEL=
# Tempo limite por chamada em ms (padrão 20000)
AI_TIMEOUT_MS=
# DP-01: organizações autorizadas a usar IA (slugs ou ids, separados por vírgula). Vazio = nenhuma.
# "*" só vale com AI_PROVIDER=simulated (desenvolvimento); com o Gemini, liste somente organizações sintéticas.
AI_SYNTHETIC_ORGS=*
AI_QUOTA_DEFAULT_OPS=1500
AI_GLOBAL_BUDGET_USD=5
# Varredor da outbox (/api/internal/jobs), mínimo 32 caracteres
CRON_SECRET=
# Medição N7 (/api/internal/n7), mínimo 32 caracteres; vazio = desativado
N7_TOKEN=
# Anti-bot do portal (Cloudflare Turnstile, gratuito). Chaves de TESTE da Cloudflare (sempre aprovam):
# TURNSTILE_SITE_KEY=1x00000000000000000000AA  TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Anexos: local (desenvolvimento, pasta .storage/) | vercel-blob (store privado; exige BLOB_READ_WRITE_TOKEN ou OIDC)
STORAGE_PROVIDER=local
