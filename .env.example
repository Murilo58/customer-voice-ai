# Copie para .env (fora do Git). Somente dados sintéticos fora da produção.
# Conexão do dono do schema (migrations; conexão direta, sem pooler)
DATABASE_URL_MIGRATOR=
# Conexão da aplicação (papel app_runtime, sem BYPASSRLS; pooler no Neon)
DATABASE_URL=
# neon | pg  (pg para PostgreSQL local/CI)
DATABASE_DRIVER=neon
# Senha do papel app_runtime, usada só por scripts/db/bootstrap-roles.mjs
APP_RUNTIME_PASSWORD=
# Banco de testes de integração (mesmas regras; nunca o de produção)
TEST_DATABASE_URL_MIGRATOR=
TEST_DATABASE_URL=
# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# E-mail: console (padrão; Resend aguarda a PoC 3)
EMAIL_PROVIDER=console
# Triagem por IA (I-2). "simulated" até a PoC 2; "gemini" ainda bloqueado.
AI_PROVIDER=simulated
AI_QUOTA_DEFAULT_OPS=1500
AI_GLOBAL_BUDGET_USD=5
# Varredor da outbox (/api/internal/jobs), mínimo 32 caracteres
CRON_SECRET=
# Medição N7 (/api/internal/n7), mínimo 32 caracteres; vazio = desativado
N7_TOKEN=
